# Concatenate the string 'Thirty', 'Days', 'Of', 'Python' to a single string, 'Thirty Days Of Python'.
Result = 'Thirty' + ' ' + 'Days' + ' ' + 'Of' + ' ' + 'Python'
print(Result)

# Concatenate the string 'Coding', 'For' , 'All' to a single string, 'Coding For All'.
Join_string = 'Coding' + ' ' + 'For' + ' ' + 'All'
print(Join_string)

# Declare a variable named company and assign it to an initial value "Coding For All".
company = 'Coding For All'

# Print the variable company using print().
print(company)

# Print the length of the company string using len() method and print().
print(len(company))

# Change all the characters to uppercase letters using upper() method.
print(Join_string.upper())

# Change all the characters to lowercase letters using lower() method.
print(Join_string.lower())

# Use capitalize(), title(), swapcase() methods to format the value of the string Coding For All.
print(Join_string.capitalize())
print(Join_string.title())
print(Join_string.swapcase())

# Cut(slice) out the first word of Coding For All string.
print(Join_string[0:6])

# Check if Coding For All string contains a word Coding using the method index, find or other methods.
print(Join_string.index('Coding'))

# Replace the word coding in the string 'Coding For All' to Python.
print(Join_string.replace('Coding', 'Python'))

# Split the string 'Coding For All' using space as the separator (split()) 
print(Join_string.split())

